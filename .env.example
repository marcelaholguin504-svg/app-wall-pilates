# Duerme Ya

# --- Cliente (Vite) — se incluyen en el bundle del navegador, deben ser
# seguras de exponer públicamente. Nunca pongas aquí la service_role key. ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ID del Meta Pixel ya conectado en Meta Business Manager (solo números).
# Sin esta variable, el quiz en /quiz no se rompe, pero tampoco manda
# ningún evento a Meta — configúrala también en Vercel (Project Settings
# → Environment Variables), no solo aquí.
VITE_META_PIXEL_ID=

# --- Servidor (funciones serverless en /api) — NUNCA se exponen al navegador.
# No las prefijes con VITE_. Configúralas también en Vercel (Project Settings
# → Environment Variables), no solo en .env.local. ---

# Mismo proyecto que arriba, pero la app la usa del lado del servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co

# Panel de Supabase → Project Settings → API → "service_role" (secreta).
# Necesaria para que el webhook de Hotmart pueda crear cuentas sin que haya
# una sesión de usuario todavía.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Panel de Hotmart → configuración del webhook/postback → HOTTOK.
# Se usa para verificar que las notificaciones de compra realmente vienen
# de Hotmart antes de crear cualquier cuenta.
HOTMART_HOTTOK=your_hotmart_hottok

# Resend → Webhooks → el webhook que apunta a /api/resend-webhook →
# "Signing Secret" (empieza con whsec_). Se usa para verificar que el
# webhook realmente viene de Resend antes de hacer nada con él.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret

# Resend → API Keys. Necesaria para poder ENVIARTE la alerta cuando un
# correo de acceso rebote, se retrase, o se marque como spam.
RESEND_API_KEY=re_your_resend_api_key

# A qué correo mandar la alerta "⚠️ Un correo de acceso no llegó".
ALERTAS_EMAIL=tu-correo@ejemplo.com

# Opcional: remitente de esa alerta (debe ser de un dominio verificado en
# Resend). Si no se define, usa "Duerme Ya <alertas@duerme-ya.com>".
ALERTAS_FROM_EMAIL=

